# Astro build output
dist/
.astro/

# OG/Twitter card images — regenerated by scripts/generate-og-images.mjs on
# every build (unlike the resume PDFs, this doesn't need Chromium, so there's
# no reason to freeze it as a committed binary). See that script's own header.
public/og/

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# Lighthouse CI
.lighthouseci/
lighthouse-report/

# Cloudflare / Wrangler local state
.wrangler/

# Editor / OS cruft
.DS_Store
.idea/
*.swp

# Raw video is never a servable asset — the media schema (src/content.config.ts)
# only renders `image` (through Astro's image()) or `youtube`; there is no
# self-hosted-video type. So a .mp4/.mov under src/ can only be undigested
# source footage, never a real asset.
*.mp4
*.mov

# It Fits I Sits (#46): raw jam-era photos kept on disk for a later content
# pass — comparison shots, maybe a video — but never committed. Only the
# processed gallery-*.webp files in this folder are real assets.
src/assets/images/projects/it-fits-i-sits/paper-prototype.jpg
src/assets/images/projects/it-fits-i-sits/level-43-screen.jpg
src/assets/images/projects/it-fits-i-sits/peoples-choice-award.jpg

# Claude Code local overrides (project settings.json IS committed on purpose)
.claude/settings.local.json
