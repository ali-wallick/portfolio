---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectMeta from '~/components/ProjectMeta.astro';
import ProjectVisual from '~/components/ProjectVisual.astro';
import { site } from '~/config/site';
import { getFeaturedProjects, getCurrentWork } from '~/lib/content';
import { personJsonLd } from '~/lib/structured-data';
import portrait from '~/assets/images/me.jpg';

const featured = await getFeaturedProjects();
const { since, doing, company } = await getCurrentWork();
/**
 * The "Currently" line, composed here rather than stored as a sentence (#207).
 * The facts come from the current job; the framing, the studio's name and the
 * exclamation are this page's. "A new team", not "the studio's next team" —
 * #129's correction, and About writes the same framing in its own sentence.
 *
 * The exclamation is deliberate and is the site's second one in visible prose
 * (see `write-copy`'s settled note on dosage). Ali's call, 2026-08-26: the
 * homepage wanted a warmth beat, and the current work is the thing worth
 * being glad about.
 *
 * LENGTH IS LOAD-BEARING (#253, 2026-08-31). This renders in a bordered box
 * that fills the page column, and its text fills the box rather than stopping
 * at the reading measure. At the shipped column it is one clean line down to a
 * 900px viewport, and 90 characters is the ceiling: a 96-character version
 * wrapped to 89 + a 6-character orphan ("Godot!" alone). Asserted at build
 * time so a longer `doing` fails here instead of orphaning a word in
 * production.
 */
const CURRENTLY_MAX = 90;
const currently = `Since ${since}, I’ve been on a new team at ${company}, ${doing}!`;
if (currently.length > CURRENTLY_MAX) {
  throw new Error(
    `homepage "Currently" line is ${currently.length} characters (max ${CURRENTLY_MAX}); ` +
      `shorten \`current.doing\` on the current job: "${currently}"`,
  );
}
const jsonLd = await personJsonLd();
---

<BaseLayout
  title={`${site.name} — ${site.roles[0]}`}
  description="Ali Wallick, game developer. Fifteen years in UI and systems engineering, five of them on Marvel Snap at Second Dinner."
  image="/og/home.jpg"
  bareTitle
  socialTitle={`${site.name} — ${site.role}`}
  jsonLd={jsonLd}
>
  {/* The face was already here, just not on the page: `buildBrandCard()` in
      scripts/generate-og-images.mjs has composited `me.jpg` into /og/home.jpg
      since #70, so a share of the homepage led with Ali’s photo beside her
      name while the page itself ran text-only until the first project
      thumbnail. This is the page keeping the card’s promise (#181).

      Same source file as /about’s `.portrait`, deliberately — one headshot,
      one crop value, two slots. */}
  {/* Four flat children, no wrapper around the heading. Each is placed by
      grid area, which is what lets the narrow layout sit the photo beside the
      name while the eyebrow above and the lede below stay full width. A
      wrapper would force those three to move as a unit. */}
  <div class="hero">
    <figure class="hero-portrait">
      <Image
        src={portrait}
        alt="Ali Wallick"
        widths={[104, 208, 416]}
        sizes="(max-width: 40em) 4.5rem, 13rem"
        loading="eager"
      />
    </figure>

    <p class="eyebrow">{site.role}</p>

    <h1>{site.name}</h1>

    <p class="lede">
      I’m a software engineer who’s spent fifteen years building game UI and systems. Most recently,
      I shipped <a href="/projects/marvel-snap">Marvel Snap</a> at Second Dinner.
    </p>
  </div>

  <div class="currently">
    <p class="eyebrow">Currently</p>
    <p>{currently}</p>
  </div>

  <h2>Featured Work</h2>
  {/* Full-width cards rather than a grid. Five entries, each a deep write-up —
      the archive's twelve get the compact treatment on /projects, so the two
      tiers differ structurally and not only in what they are called. */}
  {/* Bigger than /projects' 9rem default (base.css) — wide cards with no
       summary paragraph beside them read better a little larger here than
       the square ones on /projects do. Settled on a live slider comparing
       both pages side by side (#64). */}
  <ul class="card-grid" style="--thumb-card-size: 12rem">
    {featured.map((project, i) => (
      <li>
        <a class="card" href={`/projects/${project.id}`}>
          <span class="card-index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <ProjectVisual project={project} aspect="wide" />
          <div class="card-body">
            <h3 class="card-title">{project.data.title}</h3>
            <ProjectMeta project={project} />
          </div>
        </a>
      </li>
    ))}
  </ul>

  {/* Not `button-accent`: that fill is `--color-accent-block`, the same
       token the nav's current-page pill uses, and tokens.css reserves magenta
       for "where you are," never a link to somewhere else (#315). Plain
       `.button` is the same treatment the contact page's social links and
       the gallery arrows use. */}
  <p>
    <a class="button" href="/projects">
      All projects
    </a>
  </p>
</BaseLayout>
