---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectMeta from '~/components/ProjectMeta.astro';
import { site } from '~/config/site';
import { getFeaturedProjects } from '~/lib/content';

const featured = await getFeaturedProjects();
---

{
  /* TODO(phase-6): rework this description for search/link-preview purposes once
    the site's visual identity exists to back it up — it's accurate, not tuned. */
}
<BaseLayout
  title={`${site.name} — ${site.role}`}
  description="Website and portfolio for Ali Wallick, a game developer working in UI and systems engineering."
  bareTitle
>
  <h1>{site.name}</h1>
  <p class="meta">{site.role}</p>

  <p>
    I'm a software engineer who's spent fifteen years on game UI and systems, most recently five of
    them on <a href="https://marvelsnap.com/credits/">Marvel Snap</a> at Second Dinner. Since 2024 I've
    been on the studio's next game, being built in Godot.
  </p>
  {
    /* TODO(phase-7): a "currently" line that is cheap enough to update that the
      site can be trivially correct rather than expensively correct. */
  }

  <h2>Featured work</h2>
  <ul class="project-list">
    {
      featured.map((project) => (
        <li>
          <a href={`/projects/${project.id}`}>{project.data.title}</a>
          <ProjectMeta project={project} />
        </li>
      ))
    }
  </ul>

  <p><a href="/projects">All projects</a></p>
</BaseLayout>
