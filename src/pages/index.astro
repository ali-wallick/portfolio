---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectMeta from '~/components/ProjectMeta.astro';
import ProjectVisual from '~/components/ProjectVisual.astro';
import { site } from '~/config/site';
import { getFeaturedProjects, getCurrentNote } from '~/lib/content';

const featured = await getFeaturedProjects();
const currentNote = await getCurrentNote();
---

{
  /* TODO(phase-6): #27 — rework this description for search/link-preview purposes once
    the site's visual identity exists to back it up — it's accurate, not tuned. */
}
<BaseLayout
  title={`${site.name} — ${site.role}`}
  description="Website and portfolio for Ali Wallick, a game developer working in UI and systems engineering."
  image="/og/home.jpg"
  bareTitle
>
  <div class="hero">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.name}</h1>

    <p class="lede">
      I'm a software engineer who's spent fifteen years on game UI and systems, most recently five
      of them on <a href="/projects/marvel-snap">Marvel Snap</a> at Second Dinner.
    </p>
  </div>

  <div class="currently">
    <p class="eyebrow">Currently</p>
    <p>{currentNote}</p>
  </div>

  <h2>Featured work</h2>
  {
    /* Full-width cards rather than a grid. Five entries, each a deep write-up —
      the archive's twelve get the compact treatment on /projects, so the two
      tiers differ structurally and not only in what they are called. */
  }
  <ul class="card-grid">
    {
      featured.map((project, i) => (
        <li>
          <a class="card" href={`/projects/${project.id}`}>
            <span class="card-index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <ProjectVisual project={project} />
            <div class="card-body">
              <h3 class="card-title">{project.data.title}</h3>
              <ProjectMeta project={project} />
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <p><a class="button button-accent" href="/projects">All projects</a></p>
</BaseLayout>
