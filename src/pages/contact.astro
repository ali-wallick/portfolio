---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHead from '~/components/PageHead.astro';
import { site, socials } from '~/config/site';
import { showDrafts } from '~/lib/content';
import { externalLinkProps } from '~/lib/links';
import { socialIcons } from '~/lib/social-icons';

/**
 * No form. The old contact page posted to a PHP mail handler with no CSRF token,
 * no rate limiting, and a bug that silently discarded the sender's name — and a
 * static site has nowhere to run it anyway. A mailto and a short list of
 * accounts that actually represent Ali is the whole feature.
 *
 * Social links carried over from the old site are `pending` until the Phase 3
 * audit re-confirms them, so they only render on drafts-visible builds.
 */
const shown = socials.filter(
  (s) => s.status === 'active' || (showDrafts && s.status === 'pending'),
);
---

<BaseLayout title="Contact" description="Get in touch with Ali Wallick." image="/og/contact.jpg">
  <PageHead title="Contact" />

  {/* The page said *how* to reach Ali and never *why*, so a reader had to guess
      what was worth writing about (#119). /about carries a standing offer to talk
      about the work and had no call to action anywhere on the site; it links here
      now, which is the other half of this change.

      A sentence, not a bulleted "I'd love to hear from you if..." list. This is
      the microcopy register, and the list shape is what every template reaches
      for. It also deliberately avoids restating /about's own sentences, which
      would be one fact written in two places.

      "Roles", last, rather than "Hiring", first. Ali's call: she is open to
      hearing about them and is not looking, and a bare "Hiring" at the head of
      the list reads as more open than that.

      The exclamation is Ali's, asked for directly, which is how both of the
      site's other two got there as well. It is this page's only warmth beat, and
      the first one outside the closing section of a page that has a closer.

      The Godot work is not named as a reason. It is the one thing the standing
      brief fences off, and inviting questions about it in writing is different
      from declining them in a reply. */}
  <p>
    Email is the best way to reach me. Invitations to speak to a class or group, questions about
    anything on this site, and roles are all welcome!
  </p>

  {/* Phase 5 makes these controls rather than a list of links, and the reason
      is the same rule the rest of the direction follows: a contact page is a
      surface you *act on*, not one you read, so it is where the pressable
      treatment belongs. No content changes — the address and the accounts are
      Phase 3's, unchanged. */}
  <a class="card contact-card" href={`mailto:${site.email}`}>
    <span class="eyebrow">Email</span>
    <span class="contact-address">{site.email}</span>
  </a>

  {shown.length > 0 && (
    <ul class="button-row">
      {shown.map((s) => (
        <li>
          <a class="button" href={s.url} {...externalLinkProps(s.url)}>
            {socialIcons[s.label] && (
              <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={socialIcons[s.label]} />
              </svg>
            )}
            {s.label}
            {s.status === 'pending' && <span class="draft-flag">unverified</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
