---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResumeDocument from '~/components/ResumeDocument.astro';
import PageHead from '~/components/PageHead.astro';
import ResumeActions from '~/components/ResumeActions.astro';
import '~/styles/resume.css';

/* See resume.astro — same print-only Public Sans import, needed here too
   since /resume/full renders through the same print pipeline. */
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-700.css';
/* The group subtitle is italic on both surfaces (#235): Public Sans for
   paper, and Figtree's own italic for the screen so it is not synthesised.
   Route-scoped like the rest — nothing else on the site sets italic. */
import '@fontsource/public-sans/latin-400-italic.css';
import '@fontsource-variable/figtree/wght-italic.css';
/* The name on paper is Gabarito (#235) — the STATIC 700, not the variable
   face BaseLayout already loads. Chromium embeds a variable font's instance
   as a Type 3 font (glyphs as drawing procedures, no BaseFont entry), which
   is the one kind of PDF text applicant-tracking parsers most often fail to
   read, and on a résumé the name is the worst place for that. The static
   file embeds as an ordinary CIDFontType2 like Public Sans does. */
import '@fontsource/gabarito/latin-700.css';

/**
 * The two-page resume — the same document as `/resume`, with each job's
 * `highlightsExtended` bullets appended.
 *
 * It is a superset by construction, not by discipline: there is one component
 * and one set of bullets, and `data-density` only decides how many of them
 * show. This route stays a plain static page on purpose — it is the no-JS
 * fallback for /resume's in-place toggle and the source of resume-full.pdf,
 * so it loads no script and its links are ordinary navigation.
 */
---

<BaseLayout
  title="Resume (full)"
  description="Ali Wallick’s full resume. Game developer, fifteen years in UI and systems engineering."
  image="/og/resume.jpg"
>
  {
    /* #247, same as /resume. The h1 is "Resume" on both densities: this is the
      same document at a different length, not a different page, and the
      density is what the tabs below say. */
  }
  <PageHead title="Resume" />
  <ResumeActions current="full" />
  <ResumeDocument density="full" />
</BaseLayout>
