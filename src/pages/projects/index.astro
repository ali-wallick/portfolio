---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectMeta from '~/components/ProjectMeta.astro';
import ProjectVisual from '~/components/ProjectVisual.astro';
import { getFeaturedProjects, getArchiveProjects } from '~/lib/content';

const featured = await getFeaturedProjects();
const archive = await getArchiveProjects();

/* Counted, never typed. "Adding a project is one Markdown file" is the content
   model's central promise, and a hand-written total is exactly the second place
   to update that the model exists to rule out. */
const total = featured.length + archive.length;
---

<BaseLayout
  title="Projects"
  description="Games and projects by Ali Wallick, from shipped titles to game jam entries."
  image="/og/projects.jpg"
>
  <div class="page-head">
    <p class="eyebrow">{total} entries</p>
    <h1>Projects</h1>
  </div>

  <h2>Featured</h2>
  <ul class="card-grid">
    {
      featured.map((project, i) => (
        <li>
          <a class="card" href={`/projects/${project.id}`}>
            <span class="card-index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <ProjectVisual project={project} aspect="square" />
            <div class="card-body">
              <h3 class="card-title">{project.data.title}</h3>
              <ProjectMeta project={project} />
              {project.data.summary && <p>{project.data.summary}</p>}
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  {
    /* The archive tier is framed as history, not as a portfolio pitch — the
      `status` field on each entry keeps a 48-hour jam entry from reading like a
      shipped commercial title.

      Phase 5 renders that rather than only wording it: twelve compact tiles
      with a coloured status chip apiece, which reads as a collection screen and
      lets the tier be browsable at a glance without competing with the five
      featured write-ups above it. */
  }
  <h2>Archive</h2>
  <ul class="tile-grid">
    {
      archive.map((project) => (
        <li>
          <a class="tile" href={`/projects/${project.id}`}>
            <ProjectVisual project={project} size="tile" aspect="wide" />
            <h3 class="tile-title">{project.data.title}</h3>
            <ProjectMeta project={project} />
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
