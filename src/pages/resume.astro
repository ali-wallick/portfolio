---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResumeDocument from '~/components/ResumeDocument.astro';
import ResumeActions from '~/components/ResumeActions.astro';
import '~/styles/resume.css';

/* Self-hosted, latin subset, weight axis only — same reasoning as BaseLayout's
   screen fonts. Print-only: resume.css's `@media print` block is the only
   place `--font-body` points at Public Sans, so this has no effect on the
   on-screen page, which still reads in Figtree. It exists so the print block
   names a specific embeddable face instead of `system-ui`, which resolves to
   a different, unlicensed-for-embedding typeface (SF Pro) on every machine
   that renders it — see #191. */
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-700.css';

/**
 * The one-page resume — the version you attach to an application.
 *
 * The old site's "resume" was a 1700×2200 PNG: unselectable, unsearchable, and
 * invisible to screen readers. This is real text, rendered from the same `jobs`
 * and `education` collections the About page reads, so the two cannot drift.
 *
 * `/resume/full` is the same document with `highlightsExtended` appended. Both
 * are rendered to PDF at build time by `scripts/build-pdf.mjs` — see
 * `src/styles/resume.css` for the print rules that make that output look
 * deliberate rather than like a printed webpage.
 */
---

<BaseLayout
  title="Resume"
  description="Ali Wallick’s resume. Game developer, fifteen years in UI and systems engineering."
  image="/og/resume.jpg"
>
  <ResumeActions current="concise" />
  <ResumeDocument variant="concise" />
</BaseLayout>
