---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResumeDocument from '~/components/ResumeDocument.astro';
import PageHead from '~/components/PageHead.astro';
import ResumeActions from '~/components/ResumeActions.astro';
import '~/styles/resume.css';

/* Self-hosted, latin subset, weight axis only — same reasoning as BaseLayout's
   screen fonts. Print-only: resume.css's `@media print` block is the only
   place `--font-body` points at Public Sans, so this has no effect on the
   on-screen page, which still reads in Figtree. It exists so the print block
   names a specific embeddable face instead of `system-ui`, which resolves to
   a different, unlicensed-for-embedding typeface (SF Pro) on every machine
   that renders it — see #191. */
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-700.css';
/* The group subtitle is italic on both surfaces (#235): Public Sans for
   paper, and Figtree's own italic for the screen so it is not synthesised.
   Route-scoped like the rest — nothing else on the site sets italic. */
import '@fontsource/public-sans/latin-400-italic.css';
import '@fontsource-variable/figtree/wght-italic.css';
/* The name on paper is Gabarito (#235) — the STATIC 700, not the variable
   face BaseLayout already loads. Chromium embeds a variable font's instance
   as a Type 3 font (glyphs as drawing procedures, no BaseFont entry), which
   is the one kind of PDF text applicant-tracking parsers most often fail to
   read, and on a résumé the name is the worst place for that. The static
   file embeds as an ordinary CIDFontType2 like Public Sans does. */
import '@fontsource/gabarito/latin-700.css';

/**
 * The one-page resume — the version you attach to an application.
 *
 * The old site's "resume" was a 1700×2200 PNG: unselectable, unsearchable, and
 * invisible to screen readers. This is real text, rendered from the same `jobs`
 * and `education` collections the About page reads, so the two cannot drift.
 *
 * `/resume/full` is the same document with `highlightsExtended` appended —
 * and, since the density toggle, literally the same DOM: this page ships the
 * full superset with `data-density="concise"` hiding the two-pager's extras,
 * and src/scripts/resume-density.ts flips that attribute in place. /resume/full
 * stays the no-JS fallback. Both are rendered to PDF at build time by
 * `scripts/build-pdf.mjs` — see `src/styles/resume.css` for the print rules
 * that make that output look deliberate rather than like a printed webpage.
 */
---

<BaseLayout
  title="Resume"
  description="Ali Wallick’s resume. Game developer, fifteen years in UI and systems engineering."
  image="/og/resume.jpg"
>
  {
    /* #247. The résumé was the one route with no page title, so its content
      met the shared title edge 14px low on a desktop and 67px low on a phone,
      where the actions bar stacks. A title puts THIS page's first line where
      every other page's is, and the bar becomes what follows it rather than
      what stands in for it.

      Print never sees it — `resume.css`'s print block hides `.page-head`
      alongside `.resume-actions`, which is why the PDFs are unchanged. */
  }
  <PageHead title="Resume" />
  <ResumeActions current="concise" />
  <ResumeDocument density="concise" />
  <script is:inline>
    // Deep link: /resume#detailed must not flash concise before the deferred
    // module runs. Runs synchronously during parse, right after the article —
    // before first paint of it in practice. Top-level on purpose:
    // prettier-plugin-astro cannot parse a multi-statement <script> nested
    // inside a `{cond && (…)}` expression (see CLAUDE.md, the calibration
    // switcher note). Everything else about the toggle lives in
    // src/scripts/resume-density.ts, which only syncs the controls on load.
    if (location.hash === '#detailed') {
      document.querySelector('article.resume')?.setAttribute('data-density', 'full');
    }
  </script>
  <script>
    import '~/scripts/resume-density';
  </script>
</BaseLayout>
