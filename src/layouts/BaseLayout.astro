---
import { site, nav } from '~/config/site';
import { showDrafts } from '~/lib/content';

/* Self-hosted, latin subsets, weight axis only — no third-party requests, so
   the site stays out of cookie-banner and third-party-latency territory. The
   three faces are the gate's three type *roles*, which are settled globally;
   the faces themselves are this direction's pick. Gabarito carries the display
   voice, Figtree the reading voice, DM Mono every year, engine and role — and
   on this site that last one is a large share of the words on the page, which
   is what makes mono semantic here rather than decorative. */
import '@fontsource-variable/gabarito/wght.css';
import '@fontsource-variable/figtree/wght.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';

/* Preloaded. This direction passes the CLS gate without it, but by luck rather
   than design: Figtree and the system sans fallback happen to break lines in
   similar places. The hybrid direction used a serif whose fallback did not, and
   /about scored 0.199 CLS with an identically rem-pinned `--measure` — the
   column never resized, the prose just reflowed by whole lines. That failure
   mode is invisible until the face changes, which makes preloading the cheap
   insurance rather than an optimisation. */
import gabaritoWoff2 from '@fontsource-variable/gabarito/files/gabarito-latin-wght-normal.woff2?url';
import figtreeWoff2 from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import dmMonoWoff2 from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';

const preloadFonts = [gabaritoWoff2, figtreeWoff2, dmMonoWoff2];

import '~/styles/tokens.css';
import '~/styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** Omit the site name suffix — used by the homepage. */
  bareTitle?: boolean;
  /**
   * Unfinished work. Draft pages only ever exist on preview deploys, but
   * `noindex` makes that explicit rather than relying on nobody finding the
   * URL, and `scripts/check-links.mjs` keys its stricter rules off it.
   */
  noindex?: boolean;
  /**
   * Root-relative path to this page's OG/Twitter card, e.g. `/og/home.png`.
   * Built by scripts/generate-og-images.mjs (#27) — every caller of this
   * layout passes one. No default: a missing card should be a build-time
   * mistake to notice, not a silent fallback to a generic image.
   */
  image: string;
}

const { title, description, bareTitle = false, noindex = false, image } = Astro.props;
const fullTitle = bareTitle ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /* Use {} comments, not <!-- -->, in this file: HTML comments are emitted
         into every page, and internal notes are not something to ship. */
    }
    {
      /* The old site had no viewport meta at all, which is why it rendered
         zoomed-out on every phone ever made. */
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      /* Favicon (#26): the reticle, reduced to favicon scale — see the SVG's
         own header comment. SVG is primary and carries prefers-color-scheme
         so it reads on a light or dark tab strip; the ICO is a static
         fallback for browsers/contexts that don't take an SVG favicon, fixed
         to the light-theme accent since that's this file's default. Provisional
         per #24 — a reticle mark was Ali's call for now, and every reference to
         it lives here, so replacing the three files in public/ is the whole job
         if that changes later. */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* TODO(phase-6): robots.txt + sitemap (#28). */}
    {
      /* OG/Twitter cards (#27). The old site's og:image and og:url were both
         http://, so link previews broke in every chat app — every URL here is
         absolute https:// for the same reason `canonical` already is.

         `image` is required (see the Props comment), built by
         scripts/generate-og-images.mjs: the site's own reticle-and-name brand
         card for pages that aren't about one specific project, or a
         project's own hero/poster image framed the same way, for project
         pages. 1200x630 is the size every major surface (Slack, Discord,
         iMessage, X) wants. */
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {
      /* Cloudflare Web Analytics (#30). Gated on `!showDrafts` rather than a
         separate flag — that's already the exact production/preview split
         `build-ci.mjs` establishes, so previews and `astro dev` never report
         pageviews and only `master` builds do. No cookie banner needed: this
         beacon is cookieless by design. */
    }
    {
      !showDrafts && (
        <script
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="layout">
      {
        /* Sticky, and that is a design decision rather than a convenience: the
           reticle's resting target is the current page's nav pill, so the nav
           has to stay on screen or the brackets chase it off the top. */
      }
      <header class="site-header">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    class="nav-link"
                    href={item.href}
                    aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <nav aria-label="Footer">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a class="nav-link" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p>© {year} {site.name}</p>
      </footer>
    </div>

    {
      /* Progressive enhancement, strictly. The reticle builds its own element,
         so a page whose script never runs has no empty artifact in it — and the
         real focus outline in base.css is what makes the site navigable either
         way. */
    }
    <script>
      import '~/scripts/reticle';
    </script>
  </body>
</html>
