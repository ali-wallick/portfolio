---
import { getJobs, getEducation, formatSpanYears } from '~/lib/content';
import { bulletBlocks, currentTitle } from '~/lib/content-rules';
import { site, socials } from '~/config/site';
import {
  RESUME_TOOL_CATEGORIES,
  resumeTools,
  resumeSummary,
  resumePersonalProjects,
  resumeLocation,
} from '~/config/resume';
import { externalLinkProps } from '~/lib/links';

/**
 * The resume, at two densities, from one source.
 *
 * Phase 4 wanted both a one-page and a two-page resume. Two components — or
 * two Markdown documents — would have been faster and would have reintroduced
 * exactly the failure mode this whole content model exists to prevent: the old
 * site described the Marvel game as "upcoming" on four pages simultaneously
 * because four pages each owned their own copy of the fact.
 *
 * So there is one component and one collection, and `full` is a strict
 * superset of `concise` — it appends `highlightsExtended` to `highlights`
 * rather than swapping in a different list. A bullet cannot say one thing on
 * the short version and another on the long one, because there is only ever
 * one copy of it.
 *
 * Both densities now ship in ONE DOM. Every node always renders; full-only
 * nodes carry `data-full-only`, and `data-density` on the article decides
 * visibility via the one both-media rule in src/styles/resume.css:
 *
 *   .resume[data-density='concise'] [data-full-only] { display: none }
 *
 * That is what lets /resume toggle density in place (src/scripts/
 * resume-density.ts) instead of navigating — and it governs paper too, so
 * printing a page prints the density you are looking at. `density` here is
 * only the INITIAL state attribute, no longer a render switch.
 */
interface Props {
  density: 'concise' | 'full';
}

const { density } = Astro.props;

/**
 * Emit `data-full-only` as a valueless attribute, or omit it entirely.
 * CSS matches on presence, so the value never matters — `undefined` is how
 * Astro is told to leave the attribute off.
 */
const fullOnly = (on: boolean) => (on ? '' : undefined);

const jobs = await getJobs('resume');
const education = await getEducation();

const linkedIn = socials.find((s) => s.label === 'LinkedIn' && s.status === 'active');

/**
 * The running header on every printed page after the first (#235): the name
 * in the page's top margin, opposite a page count. The margin boxes' type
 * and colour live in src/styles/resume.css with the rest of paper; only the
 * one declaration that needs `site.name` is emitted here, so the name is
 * not written down a second time in a stylesheet.
 *
 * A raw `<style>` via `set:html` rather than an Astro `<style>` block: Astro
 * cannot interpolate into a style block, and `define:vars` cannot reach a
 * margin box's `content`. Nothing prettier-plugin-astro has to parse.
 *
 * The `:first` exclusion is repeated here, AFTER the content rule, and it is
 * not redundant with resume.css's copy: Chromium resolved these by source
 * order rather than by `:first`'s higher specificity, and the first render
 * printed the name twice on page 1 — once in the margin box, once in the
 * header — because this style is emitted later in the document than the
 * stylesheet's `:first`.
 */
const runningHeaderCss =
  `<style>@media print { @page { @top-left { content: ${JSON.stringify(site.name)}; } } ` +
  `@page :first { @top-left { content: none; } } }</style>`;

/** `2011` from `2011-05`; the year alone is all a degree line needs. */
const gradYear = (value: string) => value.slice(0, 4);

type Bullet = (typeof jobs)[number]['data']['highlights'][number];
/** A bullet plus where it came from — `highlightsExtended` bullets render on
 * both routes now and are hidden at concise density by `data-full-only`. */
type MergedBullet = Bullet & { fullOnly: boolean };
---

<Fragment set:html={runningHeaderCss} />
<article class="resume" data-density={density}>
  {
    /* The site header carries this on screen, but a printed page has no nav —
       and a PDF that doesn't say whose resume it is on the page itself is a
       PDF that gets separated from its filename and lost. */
  }
  <header class="resume-head">
    <h1>{site.name}</h1>
    {
      /* The location on its own line under the role, on both surfaces
         (#235 — settled on paper first, then Ali asked the screen to match).
         Two paragraphs rather than one string with a hidden separator, since
         nothing joins them anywhere any more. */
    }
    <p class="resume-role">{site.role}</p>
    <p class="resume-location">{resumeLocation}</p>
    <ul class="resume-contact">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.url}>{site.url.replace(/^https?:\/\//, '')}</a></li>
      {
        linkedIn && (
          <li>
            <a href={linkedIn.url} {...externalLinkProps(linkedIn.url)}>
              {linkedIn.url.replace(/^https?:\/\/(www\.)?/, '')}
            </a>
          </li>
        )
      }
    </ul>
  </header>

  {
    /* Summary and Personal Projects are full-only (`data-full-only`), settled
       with Ali on #32. The one-pager is the document you attach to an
       application; a summary there restates the title line directly above it,
       and 2011 jam entries compete badly for space against 2024 work under the
       recency-weighting rule. The two-pager has room for both — see
       src/config/resume.ts. */
  }
  <section class="resume-section" aria-labelledby="summary" data-full-only>
    <h2 id="summary">Summary</h2>
    <p class="resume-summary">{resumeSummary}</p>
  </section>

  <section class="resume-section" aria-labelledby="skills">
    <h2 id="skills">Skills</h2>
    <dl class="resume-skills">
      {
        RESUME_TOOL_CATEGORIES.map((category) => (
          <div class="resume-skills-row">
            <dt>{category}</dt>
            <dd>{resumeTools[category].join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="resume-section" aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    {
      jobs.map((job) => {
        const bullets: MergedBullet[] = [
          ...job.data.highlights.map((b) => ({ ...b, fullOnly: false })),
          ...job.data.highlightsExtended.map((b) => ({ ...b, fullOnly: true })),
        ];
        // `roles[]` carries the full progression and the resume deliberately
        // prints only the current title — Ali's call, 2026-08-26 (#32). It used
        // to render "· Previously Software Engineer II (2019 – Dec 2021)".
        // Same shape as `honors` on education below: recorded is not the same
        // as shown, and the progression still has a reader in
        // docs/LINKEDIN.md, where LinkedIn models multiple positions under one
        // company natively and genuinely wants it.

        return (
          <section class="resume-job">
            <div class="resume-job-head">
              {/* Company first, and bold (#235, Ali's call). The title was
                   first through Phase 4 — her 2019 résumé's order — but on
                   this document the companies are the recognisable half and
                   the titles are generic, so the weight moved to the
                   employer. Same shape on the education entry below. */}
              <h3>
                <span class="resume-company">{job.data.company}</span>{' '}
                <span class="resume-sep">·</span>{' '}
                <span class="resume-title">{currentTitle(job)}</span>
              </h3>
              <p class="meta resume-dates">{formatSpanYears(job.data.start, job.data.end)}</p>
            </div>
            {/* One-pager drops per-entry locations entirely, Ali's call
                 (#32). Three of four jobs said "Irvine, CA", so the column was
                 mostly repetition, and the header now states the region once.
                 Worth 78px on a document that had 24px of slack. The two-pager
                 keeps them, which also keeps `full` a strict superset of
                 `concise`. */}
            <p class="meta resume-job-meta" data-full-only>
              {job.data.location}
            </p>
            {/* Company-level prose, above the bullets and outside them. Ali's
                 call (#32): under one employer for seven years, the fact that
                 belongs to the employer shouldn't be riding on the front of a
                 bullet about one of its games. */}
            {job.data.intro && <p class="resume-job-intro">{job.data.intro}</p>}
            {bulletBlocks(bullets, job.data.bulletGroups).map((block) => {
              /* A block whose items are ALL extended is itself full-only: its
                 heading, subtitle and `<ul>` must hide at concise density or
                 the one-pager shows an empty group. No group is shaped that way
                 today, and a whole JOB can't be (every job carries a 1-bullet
                 `highlights` floor -- CLAUDE.md's weighting rule), so this
                 guard is for the group case only.

                 Derived here rather than in `bulletBlocks` (#328): print
                 density is a fact about the résumé's two documents and means
                 nothing on LinkedIn, which shares the grouping and not this. */
              const blockFullOnly = block.items.every((item) => item.fullOnly);
              return (
                <>
                  {block.heading && (
                    <div class="resume-bullet-group" data-full-only={fullOnly(blockFullOnly)}>
                      <h4>{block.heading.label}</h4>
                      {/* Two-pager only, Ali's call (#32) -- same shape as the
                         per-entry locations above. The job's own span sits
                         directly overhead on the one-pager, and a second date
                         column under it reads as clutter at that density. */}
                      {block.heading.dates && (
                        <p class="meta resume-dates" data-full-only>
                          {block.heading.dates}
                        </p>
                      )}
                    </div>
                  )}
                  {/* Group-level prose, the same idea as the job's `intro` one
                     level down. Renders on both densities -- it is a fact about
                     the whole span rather than extra detail. */}
                  {block.heading?.intro && (
                    <p class="resume-group-intro" data-full-only={fullOnly(blockFullOnly)}>
                      {block.heading.intro}
                    </p>
                  )}
                  <ul class="resume-bullets" data-full-only={fullOnly(blockFullOnly)}>
                    {block.items.map((h) => (
                      <li data-full-only={fullOnly(h.fullOnly)}>
                        <b class="resume-bullet-label">{h.label}:</b> {h.text}
                        {/* The space lives INSIDE the span, so hiding the span
                           removes it too and the concise sentence ends clean.
                           Don't "simplify" it to a space between the nodes:
                           Astro strips whitespace between a text node and an
                           element when a newline separates them (the 404 page's
                           missing-space bug — see CLAUDE.md, the wording
                           pass). */}
                        {h.extended && <span data-full-only> {h.extended}</span>}
                      </li>
                    ))}
                  </ul>
                </>
              );
            })}
          </section>
        );
      })
    }
  </section>

  <section class="resume-section" aria-labelledby="personal-projects" data-full-only>
    <h2 id="personal-projects">Personal Projects</h2>
    <ul class="resume-bullets resume-personal">
      {
        resumePersonalProjects.map((project) => (
          <li>
            <b class="resume-bullet-label">
              {project.slug ? (
                <a href={`${site.url}/projects/${project.slug}`}>{project.label}</a>
              ) : (
                project.label
              )}
              :
            </b>{' '}
            {project.text}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="resume-section" aria-labelledby="education">
    <h2 id="education">Education</h2>
    {
      education.map((entry) => (
        <section class="resume-job">
          <div class="resume-job-head">
            <h3>
              <span class="resume-company">{entry.data.school}</span>{' '}
              <span class="resume-sep">·</span>{' '}
              <span class="resume-title">
                {entry.data.degree} {entry.data.field}
              </span>
            </h3>
            <p class="meta resume-dates">{gradYear(entry.data.end)}</p>
          </div>
          {/* `honors` is populated in the collection and deliberately not
               rendered. A 2011 GPA and Dean's List are not load-bearing fifteen
               years into a career — recording a fact is not the same as
               showing it. */}
          <p class="meta resume-job-meta" data-full-only>
            {entry.data.location}
          </p>
        </section>
      ))
    }
  </section>
</article>
