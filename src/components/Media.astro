---
import { Image, getImage } from 'astro:assets';
import YouTube from './YouTube.astro';
import type { Project } from '~/lib/content';

/**
 * Renders one item of the media discriminated union. Every project surface goes
 * through here, so image handling and embed handling are decided once.
 *
 * ## The two surfaces want different requests
 *
 * A hero leads a page in a 44rem box. A gallery slide is sized by the row's
 * height and is far smaller. Until #166 this component asked for neither — it
 * was the only `<Image>` on the site with no `widths`/`sizes` at all, so a
 * 2048px Marvel Snap screenshot shipped whole into a ~238px grid cell. The rule
 * is `ProjectThumb.astro`'s: widths are the rendered box at 2x, not the source
 * size.
 *
 * ## Why the widths are clamped rather than written down
 *
 * Nine of the twelve galleries on this site are built from 137-296px legacy
 * assets. Asking sharp for an 800px variant of a 137px source is a request for
 * an upscale, which `astro:assets` will not do — so the request is filtered
 * against the source's own width instead of being stated as a constant. An
 * image smaller than every requested width falls back to its intrinsic size,
 * which is the largest honest thing it can offer.
 *
 * ## A dead video renders as a picture, through the same path
 *
 * `hero` is the one field the content model makes non-negotiable, so a
 * taken-down video would otherwise be a required field rendering as a black box
 * carrying YouTube's own error text. `dead: true` on the item swaps the embed
 * for its poster and captions it (#273) — the same shape `links[].dead` has had
 * since Phase 2, where a dead link renders as plain text so the credit survives
 * without the broken promise.
 *
 * It is deliberately the *same* branch an `image` item takes rather than a
 * third rendering: the still, the frame, the widths and the caption are all
 * already right there, and a separate dead-video treatment would be a second
 * place for them to drift.
 *
 * ## A LIVE video paints nothing until YouTube answers, on purpose
 *
 * #273 also proposed showing the poster behind the loading embed, on the
 * reasoning that a cold iframe painting nothing is worth fixing. Built,
 * reviewed on a preview, and **rejected by Ali** — do not put it back.
 *
 * The problem is not the wait, it is that the player paints ITS OWN thumbnail
 * when it arrives. A still underneath therefore turns one transition into two,
 * between two different pictures: ours cropped to the box, YouTube's fitted to
 * the video. Blank to video reads as loading; picture to a different picture to
 * video reads as a flash.
 *
 * Worth knowing if anyone tries again: it could not have been done in CSS
 * anyway. A loading iframe is not transparent — it paints its initial
 * `about:blank` over whatever is behind it — so the poster was invisible for
 * exactly the window it existed for until a script hid the player, which is a
 * second reason the idea is not as cheap as it looks.
 */
/**
 * A picture or a video. An `art` hero (#49) never comes through here — the
 * project page renders that itself, from `ProjectCardArt`, because it has no
 * image to size and nothing below would apply to it.
 */
type MediaItem = Exclude<NonNullable<Project['data']['hero']>, { type: 'art' }>;

interface Props {
  item: MediaItem;
  /** `hero` leads a page at 44rem; `gallery` is sized by the scroller's row. */
  surface?: 'hero' | 'gallery';
}

const { item, surface = 'hero' } = Astro.props;

/**
 * What a taken-down video is captioned with, in one place rather than per
 * project, so that flipping `dead` really is the entire remediation.
 *
 * It states a fact about the video and stops. It is not an apology, and it does
 * not describe the picture above it — the poster's own `alt` does that. Same
 * posture as a dead `link`, which renders as plain text rather than as an
 * explanation of why it isn't clickable.
 */
const DEAD_VIDEO_CAPTION = 'This video is no longer on YouTube.';

/**
 * The still this item would render as a picture. An `image` is its own; a
 * video's is its `poster`, captioned when we know the video is gone.
 *
 * Both variants therefore go through one set of image requests below, which is
 * this component's whole job — a dead video's poster on the hero surface is the
 * same box as an image on the hero surface, so it wants the same `widths` and
 * the same `sizes` rather than a second set of targets.
 */
const still =
  item.type === 'image'
    ? { src: item.src, alt: item.alt, caption: item.caption }
    : {
        src: item.poster.src,
        alt: item.poster.alt,
        caption: item.dead ? DEAD_VIDEO_CAPTION : undefined,
      };

/**
 * True when that still is what the reader actually looks at, rather than an
 * embed. A live video's poster is never rendered here — it is the thumbnail
 * source and the standby fallback, not part of this page — so it must not set
 * the slide's aspect ratio or offer zoom.
 */
const isPicture = item.type === 'image' || item.dead;

/* A hero is capped on WIDTH at 44rem (704px). A gallery slide is capped on
   HEIGHT, so its width follows its own aspect ratio: the widest a 22rem row
   can hold at 16:9 is 626px, and the 0.45-ratio portrait on I Fits I Sits is
   158px. 576 covers the top of that range at 1x, 1152 at 2x. */
const targets = surface === 'hero' ? [704, 1408] : [576, 1152];
const ceiling = targets[targets.length - 1];
/* Everything below the source, then the source's own width capped at the
   largest target. A 2048px screenshot yields 576/1152 and stops there; a 988px
   still yields 576/988, so a 2x display gets the best the file actually has;
   a 183px archive shot yields 183 alone, and no upscale is ever requested. */
const widths = [
  ...new Set([...targets.filter((w) => w < still.src.width), Math.min(still.src.width, ceiling)]),
].sort((a, b) => a - b);

/* Necessarily an over-estimate on the gallery surface, since a slide's width
   depends on its own ratio and `sizes` cannot know it. Over-estimating picks
   the larger candidate, which is the safe direction to be wrong in. */
/**
 * The gallery row sizes each slide from the source's own aspect ratio rather
 * than letting the browser work it out, because the obvious CSS answers all
 * fail. A slide has to be as wide as its IMAGE, not as wide as its caption's
 * longest line — but `width: min-content` on the figure plus `max-width: 100%`
 * on the image is circular, and it collapsed every image on the site to about
 * 60px. Dropping the `max-width` instead makes `min-content` resolve to the
 * source's full intrinsic width, which is worse.
 *
 * Astro already knows both dimensions at build time, so hand the ratio to CSS
 * and the width becomes arithmetic: `--gallery-h * --media-ar`. The caption
 * then wraps inside a box that is exactly the picture's width.
 */
const mediaVars =
  isPicture && surface === 'gallery'
    ? `--media-ar:${still.src.width} / ${still.src.height}`
    : undefined;

/**
 * Zoom (#166). A gallery image opens full size when the source has meaningfully
 * more to show than the row renders; below that a lightbox is a bigger copy of
 * what you were already looking at.
 *
 * 384px is 1.5x the settled 16rem row, and the threshold barely matters: at
 * that row height every image on the site is either >=1.60x its rendered height
 * or <=0.72x, with nothing in between. Anywhere from 0.8x to 1.5x picks the
 * same twelve images out of thirty. That is a natural split in Ali's assets
 * rather than a tuned number — nine of the twelve galleries are 137-296px files
 * from 2009-2013, and those are the ones with nothing more to show.
 *
 * Stated as an ABSOLUTE height rather than as a multiple of `--gallery-h`, so
 * which images offer zoom does not silently change if the row height is ever
 * retuned. Height is the right dimension to test because the row is sized by
 * height; width follows from the aspect ratio.
 */
const ZOOM_MIN_HEIGHT = 384;
const zoomable = isPicture && surface === 'gallery' && still.src.height >= ZOOM_MIN_HEIGHT;

/* Capped at 1600px: past that a "full size" view is serving megabytes to show
   detail no screen resolves. Only Marvel Snap's 2048px photo is affected.

   CANDIDATES, not one file (#249). The dialog used to be handed a single 1600px
   `src`, which a 390px phone then downloaded in full to paint a 245px-wide
   picture — 304kB measured, for a render the row had already solved responsively
   one element away. The same clamp-against-the-source rule the row uses applies:
   no upscale is ever requested, and a source smaller than every target yields
   itself alone.

   `href` stays the LARGEST of them, because the link is the no-script fallback
   and "open the picture" should open the best one. The candidate list rides
   along on a data attribute for the dialog, which is the only surface that can
   pick between them. */
const ZOOM_TARGETS = [768, 1200, 1600];
const ZOOM_CEILING = ZOOM_TARGETS[ZOOM_TARGETS.length - 1];
const zoomWidths = zoomable
  ? [
      ...new Set([
        ...ZOOM_TARGETS.filter((w) => w < still.src.width),
        Math.min(still.src.width, ZOOM_CEILING),
      ]),
    ].sort((a, b) => a - b)
  : [];
const zoomImage = zoomable
  ? await getImage({ src: still.src, widths: zoomWidths, format: 'webp' })
  : undefined;

/* The dialog's own `sizes`, which is a different box from the row's, and
   which has to describe the box PER WIDTH because the dialog changes shape
   (#249).
   
   Under 48em the lightbox is edge to edge, so the picture's box is the whole
   viewport. Saying 92vw there is not a rounding error but a sharpness bug:
   `sizes` sets the density the browser resolves a `w` descriptor against, so
   an understated hint makes the picture's own INTRINSIC width smaller, and
   `width: auto` then renders it at 92% of the box it was given. Measured at
   0.79x the row instead of 0.86x before this said 100vw.
   
   Above 48em the box is `min(92vw, 76rem)` and 82.6rem is where those cross.
   The pinned box can be narrower than that, so the desktop half is an
   over-estimate — which is the safe direction, since erring large costs bytes
   and erring small costs pixels. */
const ZOOM_SIZES = '(max-width: 47.999em) 100vw, (max-width: 82.6rem) 92vw, 76rem';

/* The dialog applies these BEFORE it assigns a src (#249). Without them the
   swapped `<img>` has no intrinsic size between the assignment and the decode,
   so the box collapses and then expands past where it started — two reflows per
   step, in opposite directions, measured at 520 -> 442 -> 1067 on one click.

   The width and height rather than the ratio, and the difference is not
   cosmetic: `aspect-ratio` needs one definite side to resolve against, and an
   unloaded image with `width: auto; height: auto` has neither, so a ratio alone
   changes nothing. Intrinsic dimensions are what `<Image>` already gives every
   picture in the row; this hands the dialog the same thing.

   The SOURCE's dimensions, not a candidate's — the candidates are scales of the
   same picture, and CSS scales the box down from the intrinsic size anyway. */
const zoomIntrinsic = zoomable ? { w: still.src.width, h: still.src.height } : undefined;

/* The hero hint tracks the page column, not a fixed width (#253). `.media`
   used to cap at 44rem and this said so; now it fills `.layout`, whose content
   box is the column less 1rem of padding a side. Getting this wrong is not a
   layout bug but a sharpness one — an undersized hint downloads a too-small
   file and the hero renders soft, which no build check would catch. Stated for
   the widest the column can currently be (64rem, so 62rem of content): erring
   large costs bytes, erring small costs pixels. RE-STATE IT IF THE COLUMN
   CHANGES. */
const sizes =
  surface === 'hero'
    ? '(max-width: 64rem) calc(100vw - 2rem), 62rem'
    : '(max-width: 40em) 80vw, 36rem';
---

{
  /* The frame is deliberately a frame and not a plate. This direction's
    unblurred drop shadow means one thing only — "this can be pressed" — and a
    hero image cannot, so it gets a border and a matching radius instead. */
}
<div class="media" style={mediaVars}>
  {
    item.type === 'youtube' && !item.dead ? (
      <YouTube id={item.id} title={item.title} start={item.start} />
    ) : (
      <figure>
        {/* A real link to the full-size file, upgraded into a dialog by
            gallery-zoom.ts — the same progressive-enhancement shape as the
            resume's density switch. With no script it still opens the image,
            which is the whole point of the control. */}
        <Fragment>
          {zoomable ? (
            <a
              class="gallery-zoom"
              href={zoomImage!.src}
              data-caption={still.caption}
              data-zoom-srcset={zoomImage!.srcSet.attribute || undefined}
              data-zoom-sizes={ZOOM_SIZES}
              data-zoom-w={zoomIntrinsic!.w}
              data-zoom-h={zoomIntrinsic!.h}
            >
              <Image
                src={still.src}
                alt={still.alt}
                widths={widths}
                sizes={sizes}
                loading="lazy"
                decoding="async"
              />
              <span class="gallery-zoom-hint">, open larger</span>
            </a>
          ) : (
            <Image
              src={still.src}
              alt={still.alt}
              widths={widths}
              sizes={sizes}
              loading="lazy"
              decoding="async"
            />
          )}
        </Fragment>
        {still.caption && <figcaption class="meta">{still.caption}</figcaption>}
      </figure>
    )
  }
</div>
