{
  "name": "aliwallick-portfolio",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-playwright.mjs",
    "dev": "astro dev",
    "build": "node scripts/generate-og-images.mjs && astro build && npm run build:pdf",
    "build:pdf": "node scripts/build-pdf.mjs",
    "check:pdf": "node scripts/build-pdf.mjs --check",
    "build:linkedin": "node scripts/build-linkedin.mjs",
    "check:linkedin": "node scripts/build-linkedin.mjs --check",
    "resume:headroom": "node scripts/resume-headroom.mjs",
    "check:resume-print": "node scripts/check-resume-print.mjs",
    "update:resume-print": "node scripts/check-resume-print.mjs --update",
    "build:ci": "node scripts/build-ci.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source": "node scripts/check-source.mjs",
    "check:blobs": "node scripts/check-preserved-blobs.mjs",
    "check:lines": "node scripts/check-line-length.mjs",
    "update:line-length": "node scripts/check-line-length.mjs --update",
    "links": "node scripts/check-links.mjs",
    "links:external": "node scripts/check-links-external.mjs",
    "verify": "npm run format:check && npm run check && npm run check:source && npm run check:blobs && npm run build && npm run check:pdf && npm run check:resume-print && npm run check:linkedin && npm run links && npm run check:lines"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/gabarito": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.134.0"
  }
}
